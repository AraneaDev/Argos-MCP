#!/bin/sh
# release-please cuts releases from Conventional Commits, so a subject it
# cannot classify silently skips the release it should have produced. The same
# rule is enforced on pull request titles by .github/workflows/pr-title.yml,
# because a squash merge takes the PR title as the commit subject on main.
#
# Deliberate exception (a fixup you intend to squash away):
#     git commit --no-verify
set -eu

subject=$(sed -n '1p' "$1")

# Merge, revert, and fixup subjects are generated by git itself.
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'
if printf '%s' "$subject" | grep -qE "$pattern"; then
    exit 0
fi

printf 'Commit subject is not a Conventional Commit:\n\n  %s\n\n' "$subject" >&2
printf 'Use "<type>(<optional scope>): <description>", for example:\n' >&2
printf '  fix(mysql): restore SSH tunnel retry on handshake timeout\n' >&2
printf '  feat(schema): cache enhanced column statistics per database\n\n' >&2
printf 'Types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test.\n' >&2
printf 'Only feat and fix (or a "!" / BREAKING CHANGE) cut a release.\n' >&2
exit 1
